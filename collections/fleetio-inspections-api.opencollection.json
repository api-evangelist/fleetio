{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fleetio Developer Contacts Inspections API",
    "version": "2025-05-05"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Inspections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List inspection forms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.fleetio.com/api/v1/inspection_forms",
            "params": [
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of records to return per page."
              },
              {
                "name": "start_cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for cursor-based pagination of list results."
              }
            ]
          },
          "docs": "List inspection forms"
        },
        {
          "info": {
            "name": "List submitted inspection forms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.fleetio.com/api/v1/submitted_inspection_forms",
            "params": [
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of records to return per page."
              },
              {
                "name": "start_cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for cursor-based pagination of list results."
              }
            ]
          },
          "docs": "List submitted inspection forms"
        }
      ]
    }
  ],
  "bundled": true
}